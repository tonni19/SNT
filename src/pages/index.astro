---
/**
 * The home page. Each section is a component in src/components; the scroll
 * choreography lives in src/scripts/motion.js.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FangReveal from '../components/FangReveal.astro';
import FilmStrip from '../components/FilmStrip.astro';
import Story from '../components/Story.astro';
import Numbers from '../components/Numbers.astro';
import Built from '../components/Built.astro';
import Lab from '../components/Lab.astro';
import Research from '../components/Research.astro';
import Events from '../components/Events.astro';
import Log from '../components/Log.astro';
import Band from '../components/Band.astro';
import Contact from '../components/Contact.astro';
---
<Base>
  <Hero />
  <FangReveal />
  <FilmStrip />
  <Story />
  <Numbers />
  <Built />
  <Lab />
  <Research />
  <Events />
  <Log />
  <Band />
  <Contact />
  <script>
    import '../scripts/motion.js';
  </script>
</Base>
