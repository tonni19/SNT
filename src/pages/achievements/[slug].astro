---
/** One page per competition, jam or event in src/content/achievements. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const items = await getCollection('achievements', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'achievements'>; }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const when = d.date
  ? d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : d.year ? String(d.year) : '';
const reflections = [['What I learned', d.learned], ['The experience', d.experience], ['My verdict', d.verdict]] as const;
const hasReflection = reflections.some(([, t]) => t);
---
<Base title={`${d.title} · Sadia Noman Tonni`} description={`${d.event}: ${d.result}`}>
  <article class="page">
    <div class="wrap">
      <a class="page__back" href={url('/#events')}><Icon name="arrow-left" /> All achievements</a>
      <h1 class="display page__title">{d.title}</h1>
      <p class="page__lead">{d.event !== d.title ? `${d.event}. ` : ''}{d.result}.</p>
      <ul class="page__meta" role="list">
        {when && <li>{when}</li>}
        {d.role && <li>Role: <b>{d.role}</b></li>}
        {d.team && <li>Team: <b>{d.team}{d.team_members.length ? ` (${d.team_members.join(', ')})` : ''}</b></li>}
        {d.tools.length > 0 && <li>Tools: <b>{d.tools.join(', ')}</b></li>}
      </ul>
      {hasReflection && (
        <div class="page__panels">
          {reflections.map(([h, t]) => <div><h2>{h}</h2><p>{t ?? 'Reflection coming soon.'}</p></div>)}
        </div>
      )}
      <div class="prose">
        <Content />
        {d.links.length > 0 && (<><h2>Links</h2><ul>{d.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}</ul></>)}
      </div>
    </div>
  </article>
</Base>
