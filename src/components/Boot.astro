---
// First-visit boot sequence (home page only). Runs ~1.5s, then continues on its own.
---
  <!-- ░░ BOOT SCREEN ░░ -->
  <div class="boot" id="boot" role="dialog" aria-label="Boot sequence">
    <div class="boot__inner">
      <div class="boot__bar"><span>1-Jan-87</span><span>1:44 am</span></div>
      <pre class="boot__log" id="bootLog"></pre>
      <p class="boot__prompt" id="bootPrompt">PRESS ANY KEY TO ENTER<span class="blink">_</span></p>
      <button class="boot__calm" id="bootCalm" type="button">Sensitive to flashing or motion? Enter with effects off</button>
    </div>
  </div>
