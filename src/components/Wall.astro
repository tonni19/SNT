---
// The room behind everything: binary rain with a walking cat, cold fog, dust and a torch beam.
// Animated by src/scripts/atmosphere.js.
---
  <!-- the room: black, with cold fog, drifting dust and a faint torch beam that follows the cursor -->
  <div class="wall" aria-hidden="true">
    <canvas class="binary" id="binary"></canvas>
    <div class="fog fog--far"></div>
    <div class="fog fog--near"></div>
    <canvas class="motes" id="motes"></canvas>
    <div class="torch" id="torch"></div>
    <div class="roll"></div>
  </div>
  <div class="grade" aria-hidden="true"></div>
