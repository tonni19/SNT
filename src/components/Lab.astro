---
/** UI/UX LAB: three shelves that fill from src/content/uiux by `type`. */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { uiuxShelves } from '../data/site';
import { url } from '../lib/url';
const entries = (await getCollection('uiux', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<section class="lab" id="lab" aria-labelledby="labTitle">
  <div class="wrap">
    <header class="sec-head">
      <h2 class="display sec-head__title" id="labTitle">UI/UX lab</h2>
      <p class="sec-head__lead">Where I take products apart: analyses of real product websites, case studies of my own work, and recreations of interfaces I admire.</p>
    </header>
    <div class="lab__shelves">
      {uiuxShelves.map((shelf) => {
        const items = entries.filter((e) => e.data.type === shelf.type);
        return (
          <div class="shelf">
            <h3>{shelf.title}</h3>
            <p>{shelf.blurb}</p>
            {items.length ? (
              <ul>{items.map((e) => <li><a href={url(`/uiux/${e.id}/`)}><b>{e.data.title}</b><span>{e.data.product} · {fmt(e.data.date)}{e.data.status === 'in-progress' ? ' · in progress' : ''}</span></a></li>)}</ul>
            ) : (
              <p class="shelf__soon"><Icon name="lock" /> The first one is being written.</p>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
