---
/**
 * One publication: venue, title, authors, summary and every link it may have.
 * Links that don't exist yet show as "soon".
 */
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';
interface Props { entry: CollectionEntry<'research'>; full?: boolean; }
const { entry, full = false } = Astro.props;
const d = entry.data;
const slots = [
  { key: 'arxiv', label: 'arXiv', icon: 'file-text', url: d.arxiv },
  { key: 'scholar', label: 'Google Scholar', icon: 'graduation-cap', url: d.scholar },
  { key: 'doi', label: 'DOI', icon: 'book-open', url: d.doi },
  { key: 'pdf', label: 'PDF', icon: 'file-text', url: d.pdf },
  { key: 'poster', label: 'Poster', icon: 'layout', url: d.poster },
  { key: 'code', label: 'Code & data', icon: 'code', url: d.code },
];
const shown = slots.filter((s) => s.url || ['arxiv', 'scholar', 'pdf', 'code'].includes(s.key));
const Title = full ? 'h1' : 'h3';
---
<article class="paper">
  <div class="paper__main">
    <p class="paper__meta"><b>{d.type}</b><span>{d.venue}</span><span>{d.year}</span></p>
    <Title class="paper__title">{full ? d.title : <a href={url(`/research/${entry.id}/`)}>{d.title}</a>}</Title>
    <p class="paper__authors">{d.authors.map((a, i) => <span class:list={{ me: a === 'Sadia Noman Tonni' }}>{a}{i < d.authors.length - 1 ? ', ' : ''}</span>)}</p>
    {!full && <p class="paper__summary">{d.summary}</p>}
    <ul class="paper__links" role="list">
      {shown.map((s) => (
        <li>
          {s.url
            ? <a href={s.url} target="_blank" rel="noopener"><Icon name={s.icon} />{s.label}</a>
            : <span class="is-soon" title="Not public yet"><Icon name={s.icon} />{s.label} <em>soon</em></span>}
        </li>
      ))}
      <li>
        {d.bibtex
          ? <button type="button" data-copy={d.bibtex}><Icon name="copy" /><span>Copy BibTeX</span></button>
          : <span class="is-soon" title="The citation arrives with the preprint"><Icon name="copy" />Cite <em>soon</em></span>}
      </li>
      {!full && <li class="more"><a href={url(`/research/${entry.id}/`)}>Read more <Icon name="arrow-right" /></a></li>}
    </ul>
  </div>
  <div class="paper__status">
    <small>Status</small>
    <p>{d.status}</p>
  </div>
</article>
