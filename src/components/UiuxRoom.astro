---
/**
 * UI/UX LAB: three shelves (analyses, case studies, recreations) that fill from
 * src/content/uiux by `type`, plus the interfaces already shipped. An empty
 * shelf says so honestly instead of hiding.
 */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Crt from './Crt.astro';
import { uiuxShelves, shipped } from '../data/site';

const entries = (await getCollection('uiux', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<section class="room room--wide room--uiux" id="uiux" data-room="uiux" aria-labelledby="uiuxTitle">
  <header class="room__head">
    <h2 class="room__title" id="uiuxTitle">UI/UX lab</h2>
    <p class="room__lead">Where I take products apart: analyses of real product websites, case studies of my own work, and recreations of interfaces I admire.</p>
  </header>

  <Crt channel="design lab">
    <div class="scene scene--uiux" id="scene-uiux">
      <div class="lab">
        {uiuxShelves.map((shelf) => {
          const items = entries.filter((e) => e.data.type === shelf.type);
          return (
            <div class="win lab__shelf">
              <div class="win__title"><span>{shelf.type}.dir</span><span class="lab__n">{items.length} {items.length === 1 ? 'file' : 'files'}</span></div>
              <div class="win__body">
                <h3 class="lab__title">{shelf.title}</h3>
                <p class="lab__blurb">{shelf.blurb}</p>
                {items.length ? (
                  <ul class="lab__list">
                    {items.map((e) => (
                      <li>
                        <a href={`/uiux/${e.id}/`}>
                          <b>{e.data.title}</b>
                          <span>{e.data.product} · {fmt(e.data.date)}{e.data.status === 'in-progress' ? ' · in progress' : ''}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="lab__empty"><Icon name="lock" /> Being written. The first one lands here soon.</p>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <div class="lab__shipped">
        <h3 class="pixel-h">SHIPPED <small>/ interfaces I've built</small></h3>
        <ul>
          {shipped.map((s) => (
            <li>
              <span class="lab__ship-name">{s.title}</span>
              <span class="lab__ship-what">{s.what}</span>
              <span class="lab__ship-links">
                {s.url && <a href={s.url} target="_blank" rel="noopener">[ open <Icon name="arrow-up-right" /> ]</a>}
                {s.repo && <a href={s.repo} target="_blank" rel="noopener">[ code <Icon name="code" /> ]</a>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Crt>
</section>
