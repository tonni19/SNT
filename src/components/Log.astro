---
/** LOG: the timeline, oldest first, with an open slot for whatever is next. */
import { timeline } from '../data/site';
---
<section class="log" id="log" aria-labelledby="logTitle">
  <div class="wrap">
    <header class="sec-head">
      <h2 class="display sec-head__title" id="logTitle">The log</h2>
      <p class="sec-head__lead">What I've made so far, in order.</p>
    </header>
    <ol class="log__list" role="list">
      {timeline.map((t) => <li class="log__item"><time>{t.year}</time><h3>{t.title}</h3><p>{t.text}</p></li>)}
      <li class="log__item log__item--next"><time>Next</time><h3>Not written yet</h3><p>Maybe something we make together.</p></li>
    </ol>
  </div>
</section>
