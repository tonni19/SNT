---
/** BAND: two lines of giant words that slide against each other with the scroll, a breather before contact. */
const a = ['Research', 'Human-AI', 'Game UX', 'Interfaces'];
const b = ['Art', 'Animation', 'Games', 'Design'];
---
<section class="band" aria-hidden="true">
  <div class="band__line band__line--a">{[...a, ...a, ...a].map((w) => <span>{w}</span>)}</div>
  <div class="band__line band__line--b">{[...b, ...b, ...b].map((w) => <span>{w}</span>)}</div>
</section>
