---
/** CONTACT: the ending returns to the hero: rose field, the giant name, the mascot peeking. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site, heroArt } from '../data/site';
const src = (p: string) => (p.startsWith('/art/') ? `${site.artPortfolio}${p}` : p);
---
<section class="contact" id="contact" aria-labelledby="contactTitle">
  <div class="wrap contact__grid">
    <h2 class="display contact__title" id="contactTitle">Let's make something strange</h2>
    <div class="contact__side">
      <p>Art commissions, game assets, interface work or research: write to me and I'll answer, usually around 1:44 am.</p>
      <div class="contact__links">
        <a class="btn btn--plum" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
        <a class="btn btn--line" href={site.github} target="_blank" rel="noopener"><span>GitHub</span> <Icon name="github" /></a>
        <a class="btn btn--line" href={site.artPortfolio} target="_blank" rel="noopener"><span>Art portfolio</span> <Icon name="arrow-up-right" /></a>
      </div>
    </div>
  </div>
  <div class="contact__word" aria-hidden="true">
    <p class="display">{'TONNI'.split('').map((c) => <span class="ch">{c}</span>)}</p>
    <div class="contact__peek">
      <Image src={src(heroArt.mascot.src)} alt="" width={heroArt.mascot.width} height={heroArt.mascot.height} widths={[360, 560]} sizes="22vw" loading="lazy" />
    </div>
  </div>
</section>
