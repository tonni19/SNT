---
/**
 * A CRT monitor. Whatever you put inside shows on its screen.
 * channel: the label on the monitor's chin.
 * back: on detail pages, a link shown in place of the ◀ ▶ arrows.
 */
import Icon from './Icon.astro';
interface Props {
  channel: string;
  back?: { href: string; label: string };
  class?: string;
}
const { channel, back, class: cls } = Astro.props;
---
<div class:list={['crt', cls]} data-ui>
  <div class="crt__bezel">
    <div class="crt__screen">
      <div class="screen__ui">
        <div class="viewport"><slot /></div>
        <slot name="extras" />
      </div>
      <canvas class="static" width="160" height="100" aria-hidden="true"></canvas>
      <div class="scanlines" aria-hidden="true"></div>
      <div class="glass" aria-hidden="true"></div>
    </div>
    <div class="crt__chin">
      {back ? (
        <a class="chin-back" href={back.href}><Icon name="arrow-left" /> {back.label}</a>
      ) : (
        <button class="chin-arrow" data-nav="prev" aria-label="Previous section"><Icon name="chevron-left" /></button>
      )}
      <span class="brand">MNEMOS-87 <b>· {channel}</b></span>
      <i class="power__led" aria-hidden="true"></i>
      {!back && <button class="chin-arrow" data-nav="next" aria-label="Next section"><Icon name="chevron-right" /></button>}
    </div>
  </div>
</div>
