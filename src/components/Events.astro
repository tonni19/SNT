---
/**
 * ACHIEVEMENTS: competitions, publications and jams from src/content/achievements,
 * in the order set by each entry's `order`. Rows with a reflection, team, tools or
 * links open up; the rest stay as plain rows.
 */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';
const items = (await getCollection('achievements', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const TYPE: Record<string, string> = { publication: 'Publication', competition: 'Competition', hackathon: 'Hackathon', 'game-jam': 'Game jam', event: 'Event', workshop: 'Workshop', volunteering: 'Volunteering', other: 'Other' };
const hasMore = (a: (typeof items)[number]) => !!(a.body?.trim() || a.data.team || a.data.tools.length || a.data.links.length || a.data.learned || a.data.experience || a.data.verdict);
const hasReflection = (a: (typeof items)[number]) => !!(a.data.learned || a.data.experience || a.data.verdict);
---
<section class="events" id="events" aria-labelledby="eventsTitle">
  <div class="wrap">
    <header class="sec-head">
      <h2 class="display sec-head__title" id="eventsTitle">Achievements</h2>
    </header>
    {items.length ? items.map((a, i) => {
      const num = String(i + 1).padStart(2, '0');
      const head = (
        <>
          <span class="event__date">{num}</span>
          <span class="event__name">{a.data.title}</span>
          <span class="event__result">{a.data.result}</span>
        </>
      );
      return hasMore(a) ? (
        <details class="event">
          <summary>{head}<span class="event__toggle" aria-hidden="true"><Icon name="plus" /></span></summary>
          <div class="event__body">
            {(a.data.team || a.data.tools.length > 0) && (
              <p class="event__team">
                {a.data.team && <span>Team {a.data.team}{a.data.team_members.length ? `: ${a.data.team_members.join(', ')}` : ''}</span>}
                {a.data.tools.length > 0 && <span>{a.data.tools.join(' · ')}</span>}
              </p>
            )}
            {hasReflection(a) && [['What I learned', a.data.learned], ['The experience', a.data.experience], ['My verdict', a.data.verdict]].map(([h, t]) => (
              <div><h4>{h}</h4>{t ? <p>{t}</p> : <p class="pending">Reflection coming soon.</p>}</div>
            ))}
            {!hasReflection(a) && a.data.type === 'game-jam' && (
              <div class="event__wide"><h4>My reflection</h4><p class="pending">What I learned, how it felt and my verdict are coming soon.</p></div>
            )}
            <p class="event__links">
              {a.body?.trim() && <a href={url(`/achievements/${a.id}/`)}>The full story <Icon name="arrow-right" /></a>}
              {a.data.links.slice(0, 3).map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} <Icon name="arrow-up-right" /></a>)}
            </p>
          </div>
        </details>
      ) : (
        <div class="event event--flat"><div class="event__row">{head}<span aria-hidden="true"></span></div></div>
      );
    }) : <p class="events__empty">The first entries are being written.</p>}
  </div>
</section>
