---
import Icon from './Icon.astro';
---
    <section class="room room--profile" id="profile" data-room="profile" aria-labelledby="profileTitle">
      <header class="room__head">
        <h2 class="room__title" id="profileTitle">Profile</h2>
        <p class="room__lead">Who I am, what I'm into, and roughly how much of each.</p>
      </header>

      <div class="crt" data-ui>
        <div class="crt__bezel">
          <div class="crt__screen">
            <div class="screen__ui">
              <div class="viewport">
                <div class="scene scene--profile" id="scene-profile">
                  <div class="dossier">
                    <div class="dossier__id">
                      <div class="portrait">
                        <img src="assets/art/avatar.webp" alt="Tonni's self-portrait avatar: a fanged girl holding a giant pencil" width="1080" height="1080">
                        <span class="portrait__rec"><Icon name="circle" /> REC</span>
                      </div>
                      <p class="status-line">Status: <b id="profileStatus">AWAKE</b></p>
                      <dl class="fields" id="profileFields"></dl>
                    </div>
                    <div class="dossier__main">
                      <div class="dossier__stats">
                        <h3 class="pixel-h">INTERESTS <small>/ stats</small></h3>
                        <ul class="stats" id="stats"></ul>
                      </div>
                      <div class="dossier__about">
                        <h3 class="pixel-h">about.txt</h3>
                        <p class="about" id="about"></p>
                        <div class="chips" id="chips"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <canvas class="static" width="160" height="100" aria-hidden="true"></canvas>
            <div class="scanlines" aria-hidden="true"></div>
            <div class="glass" aria-hidden="true"></div>
          </div>
          <div class="crt__chin">
            <button class="chin-arrow" data-nav="prev" aria-label="Previous section"><Icon name="chevron-left" /></button>
            <span class="brand">MNEMOS-87 <b>· subject file</b></span>
            <i class="power__led" aria-hidden="true"></i>
            <button class="chin-arrow" data-nav="next" aria-label="Next section"><Icon name="chevron-right" /></button>
          </div>
        </div>
      </div>

      <div class="desk">
        <!-- FLIP PHONE -->
        <div class="phone" data-ui>
          <div class="phone__ear"><i></i><i></i><i></i></div>
          <div class="phone__screen">
            <div class="phone__bar"><span id="phoneTime">1:44</span><span class="phone__icons"><Icon name="signal" /><Icon name="battery-full" /></span></div>
            <div class="phone__card">
              <div class="phone__avatar" aria-hidden="true"><img src="assets/art/tortilla.webp" alt="" width="1080" height="1350"></div>
              <p class="phone__name" id="phoneName">???</p>
            </div>
            <p class="phone__status">Status: <b id="phoneStatus">AWAKE</b></p>
            <ul class="phone__info" id="phoneInfo"></ul>
          </div>
          <div class="phone__pad">
            <button class="dpad" aria-label="Phone navigation">
              <span class="dpad__btn dpad__l" data-nav="prev"></span>
              <span class="dpad__btn dpad__r" data-nav="next"></span>
              <span class="dpad__btn dpad__c" data-nav="home"></span>
            </button>
            <div class="phone__keys" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
      </div>
    </section>
