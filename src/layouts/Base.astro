---
/**
 * Every page: head, icons, the atmospheric room behind it, top bar, footer.
 * Pass `current` (a room id) to highlight it in the top bar.
 */
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import Wall from '../components/Wall.astro';
import SiteBar from '../components/SiteBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  bodyClass?: string;
}
const {
  title = `${site.name} · personal archive`,
  description = `${site.name} (Tortilla): artist, game asset creator, UI/UX designer and AI × HCI researcher. A personal archive of work, research and the things I've taken part in.`,
  current,
  bodyClass,
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#000000" />
  <meta name="generator" content={Astro.generator} />
  <script is:inline>
    // Effects on/off, decided before the first paint so nothing flashes. Saved per visitor;
    // the default follows the system's reduced-motion setting.
    (function () {
      var v = null;
      try { v = localStorage.getItem('mnemos-fx'); } catch (e) {}
      var off = v ? v === 'off' : matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.dataset.fx = off ? 'off' : 'on';
      window.mnemosFx = {
        set: function (state) {
          document.documentElement.dataset.fx = state;
          try { localStorage.setItem('mnemos-fx', state); } catch (e) {}
          document.dispatchEvent(new CustomEvent('fxchange', { detail: state }));
        }
      };
    })();
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Gaegu:wght@400;700&family=Pixelify+Sans:wght@400..700&family=VT323&display=swap" rel="stylesheet" />
</head>
<body data-mood="calm" class={bodyClass}>
  <Icons />
  <Wall />
  <slot name="before" />
  <SiteBar current={current} />
  <slot />
  <SiteFooter />
  <script>
    import '../scripts/atmosphere.js';
    import '../scripts/ui.js';
  </script>
</body>
</html>
